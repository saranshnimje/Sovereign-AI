# ==============================================================
# Sovereign AI Workbench - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================

# ---- REQUIRED ----
# JWT signing secret (min 32 chars).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters-change-this

# Deployment mode: development | production
# production = the backend REFUSES TO START if SECRET_KEY is missing/short/placeholder.
# development = permissive defaults allowed for local work only.
ENVIRONMENT=development

# ---- OPTIONAL (defaults shown) ----

# Data directory — where all persistent files live (SQLite, uploads, JSON config, etc.)
# Docker:     leave unset (defaults to /app/data which is volume-mounted)
# Local dev:  set to a writable path, e.g. DATA_DIR=./data
#             If unset on local dev the backend auto-detects and uses ../data (project root)
# DATA_DIR=/app/data

# Ollama endpoint
# Mac/Windows Docker Desktop: http://host.docker.internal:11434
# Linux: http://172.17.0.1:11434  (or add extra_hosts to compose)
OLLAMA_URL=http://host.docker.internal:11434

# Qdrant endpoint (uses Docker service name inside compose network)
QDRANT_URL=http://qdrant:6333

# Frontend origin for CORS (production)
FRONTEND_ORIGIN=http://localhost

# Max file upload size in MB
MAX_UPLOAD_SIZE_MB=50

# Docker image for sandbox execution
SANDBOX_IMAGE=python:3.11-slim

# Sandbox resource limits
SANDBOX_TIMEOUT_S=30
SANDBOX_MEM_LIMIT_MB=256

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Audit log retention in days
AUDIT_RETENTION_DAYS=365

# JWT TTL
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=7

# Default AI models (must be pulled via ollama pull)
DEFAULT_CHAT_MODEL=qwen3:14b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
DEFAULT_VISION_MODEL=llava:7b

# ---- Docker sandbox access (P0 hardening) ----
# The backend reaches Docker through the least-privilege socket proxy
# (see docker-compose.yml service 'dockerproxy'). It must NEVER receive
# the raw host socket.
# DOCKER_HOST=tcp://dockerproxy:2375

# ---- Rate limiting (P0 hardening) ----
# In-process sliding window, requests/minute per client IP.
# Disable entirely with RATE_LIMIT_ENABLED=false (not recommended in production).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_MIN=30
RATE_LIMIT_AI_PER_MIN=120
